# 브라우저가 호출할 API 기본 주소.
# 비워 두면 같은 오리진의 /api/v1 을 쓰고, next.config.ts 의 rewrite 가 백엔드로 넘깁니다.
NEXT_PUBLIC_API_BASE_URL=

# rewrite 가 바라볼 백엔드 오리진. 미설정 시 http://localhost:8080 입니다.
# 배포 환경에서는 실제 백엔드 주소를 반드시 넣어야 합니다.
# BACKEND_ORIGIN=http://localhost:8080

# 토스페이먼츠 주문서형 SDK의 test_gck_ 또는 live_gck_ 클라이언트 키.
# gsk 시크릿 키를 넣지 않으며 실제 값은 .env.local에만 둡니다.
# NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=
