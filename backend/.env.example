# 실제 값은 커밋하지 않습니다. 배포에서는 환경변수/Secrets로 주입합니다.

# [Spring Boot 공통 필수] JWT 서명 키. 기본값이 없어 미설정 시 기동에 실패합니다. HS256이라 32바이트 이상이어야 합니다.
JWT_SECRET_KEY=local-dev-only-secret-key-must-be-32bytes-or-longer

# [Docker Compose 로컬 MySQL 필수]
# backend/docker-compose.yml 기동 시 MySQL root 비밀번호로 필수입니다.
# 로컬 Spring Boot(application-local.yml)의 기본 접속 비밀번호인 'root'와 일치시킵니다.
DB_PASSWORD=root

# [배포 프로필 전용]
# local 프로필에서는 application-local.yml이 localhost:3306/slotkey (root/root)로 덮어쓰므로
# Spring Boot 로컬 프로세스 기동 시에는 아래 DB_URL, DB_USERNAME이 불필요합니다.
# DB_URL=
# DB_USERNAME=

# 프론트엔드를 백엔드에 직접 붙일 때만 필요합니다.
# Next rewrite(/api/v1)를 거치면 같은 오리진이라 CORS가 적용되지 않습니다.
# 미설정 시 http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# [토스페이먼츠 샌드박스 선택]
# 실제 값은 로컬 .env 또는 프로세스 환경변수로만 주입합니다.
# TOSS_PAYMENTS_SECRET_KEY=

# 이메일 인증번호·일회용 증표 검증용 HMAC 비밀키 (32바이트 이상, Base64 인코딩)
# VERIFICATION_HASH_SECRET=

# Gmail SMTP 이메일 인증 발송 (Google 계정 일반 비밀번호가 아닌 앱 비밀번호)
# 발신 주소는 SMTP 로그인 Gmail 주소와 정확히 같아야 합니다.
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# VERIFICATION_MAIL_FROM=

# [Kafka 선택] 기본은 꺼짐(false)이라 브로커 없이 기동한다. 로컬에서 켤 때만 설정한다.
# docker compose --profile kafka up -d kafka 로 브로커를 띄운 뒤 true로 바꾼다.
# backend 디렉터리에 .env가 있어야 compose가 보간한다(mysql 서비스의 DB_PASSWORD 필수).
# SLOTKEY_KAFKA_ENABLED=...
# KAFKA_BOOTSTRAP_SERVERS=...
# SLOTKEY_KAFKA_ENABLED=...