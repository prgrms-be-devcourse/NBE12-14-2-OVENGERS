# 실제 값은 커밋하지 않습니다. 배포에서는 환경변수/Secrets로 주입합니다.

# [Spring Boot 공통 필수] JWT 서명 키. 기본값이 없어 미설정 시 기동에 실패합니다. HS256이라 32바이트 이상이어야 합니다.
JWT_SECRET_KEY=local-dev-only-secret-key-must-be-32bytes-or-longer

# [Docker Compose 로컬 MySQL 필수]
# backend/docker-compose.yml 기동 시 MySQL root 비밀번호로 필수입니다.
# 로컬 Spring Boot(application-local.yml)의 기본 접속 비밀번호인 'root'와 일치시킵니다.
DB_PASSWORD=root

# [배포 프로필 전용]
# local 프로필에서는 application-local.yml이 localhost:3306/slotkey (root/root)로 덮어쓰므로
# Spring Boot 로컬 프로세스 기동 시에는 아래 DB_URL, DB_USERNAME이 불필요합니다.
DB_URL=
DB_USERNAME=

# 프론트엔드를 백엔드에 직접 붙일 때만 필요합니다.
# Next rewrite(/api/v1)를 거치면 같은 오리진이라 CORS가 적용되지 않습니다.
# 미설정 시 http://localhost:3000
CORS_ALLOWED_ORIGINS=
