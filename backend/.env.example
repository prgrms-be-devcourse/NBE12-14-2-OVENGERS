# 실제 값은 커밋하지 않습니다. 배포에서는 환경변수/Secrets로 주입합니다.
# 로컬(local 프로필)은 application-local.yml 이 DB 접속 정보를 덮으므로
# JWT_SECRET_KEY 하나만 있으면 뜹니다.

# JWT 서명 키. 기본값이 없어 반드시 주입해야 하며, HS256 이라 32바이트 이상이어야 합니다.
JWT_SECRET_KEY=

# 아래는 local 프로필에서는 쓰이지 않습니다(application-local.yml 이 덮어씀).
# 배포 프로필에서만 필요합니다.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# 프론트엔드를 백엔드에 직접 붙일 때만 필요합니다.
# Next rewrite(/api/v1)를 거치면 같은 오리진이라 CORS 가 적용되지 않습니다.
# 미설정 시 http://localhost:3000
CORS_ALLOWED_ORIGINS=
